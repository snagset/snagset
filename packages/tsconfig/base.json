{
  "$schema": "https://json.schemastore.org/tsconfig",
  "docs": "Base config for every package. Environment-neutral: NO ambient types. dom.json / node.json add the environment. Plan: `types: []` at the base is what stops setTimeout typing as NodeJS.Timeout and process.env/Buffer leaking into a client's site.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
