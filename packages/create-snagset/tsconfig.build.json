{
  "$schema": "https://json.schemastore.org/tsconfig",
  "docs": "EMIT config. Ships JS for the same reason the server does: npm's Windows .cmd shim runs `node <file>` and ignores the shebang.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*"]
}
