{
  "$schema": "https://json.schemastore.org/tsconfig",
  "docs": "EMIT config, separate from tsconfig.json which type-checks with noEmit. The published package ships JavaScript — see and the note in package.json.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*"]
}
